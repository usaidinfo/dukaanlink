# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase: Project Settings → API
# Use the Project URL and the anon / publishable key (safe for the browser).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Production site URL (used for sitemap, canonical links, Open Graph)
# NEXT_PUBLIC_SITE_URL=https://dukaanlink.in
